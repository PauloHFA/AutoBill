# AutoBill Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED - Telegram Bot
# ===========================================
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of authorized chat IDs (user or group)
# Get your chat ID by messaging @userinfobot
ALLOWED_CHAT_IDS=123456789

# ===========================================
# EXTRACTION SETTINGS
# ===========================================
# Extraction mode: auto (default), cloud, or local
# auto: tries PDF text -> barcode -> cloud LLM -> local OCR
# cloud: uses cloud LLM (requires consent and API key)
# local: only local extraction (no data leaves your machine)
EXTRACTOR=auto

# Consent for sending documents to cloud LLM (required for cloud mode)
# Set to true only if you understand and accept the privacy implications
CLOUD_EXTRACTION_CONSENT=false

# Cloud LLM API Key (Gemini Flash)
# Get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Local LLM (Ollama) - used when EXTRACTOR=local or auto fallback
OLLAMA_HOST=http://ollama:11434
LLM_VISION_MODEL=qwen2.5-vl

# ===========================================
# ALERT SETTINGS
# ===========================================
# Timezone for alert scheduling (IANA timezone)
DEFAULT_TIMEZONE=America/Fortaleza

# Daily alert time (HH:MM in DEFAULT_TIMEZONE)
ALERT_TIME=07:30

# Days before due date to send alerts (comma-separated)
# Default: 3 days before, 1 day before, on the day
LEAD_DAYS=3,1,0

# Auto-confirm bills that pass all validations (no human review needed)
AUTO_CONFIRM=false

# ===========================================
# OPTIONAL - IMAP EMAIL INGESTION
# ===========================================
# Enable IMAP monitoring (requires imap-tools)
IMAP_ENABLED=false

# IMAP server settings
IMAP_HOST=imap.gmail.com
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password

# Optional: comma-separated list of allowed sender emails
# If empty, all senders are accepted
ALLOWED_SENDERS=

# ===========================================
# STORAGE SETTINGS
# ===========================================
# Database path (inside container: /app/data/autobill.db)
DB_PATH=/app/data/autobill.db

# Data directory
DATA_DIR=/app/data

# File retention in days (original files)
FILE_RETENTION_DAYS=90

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_JSON=true